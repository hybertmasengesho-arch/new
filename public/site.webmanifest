{
  "name": "Cortex — Share files. Collaborate. Authenticated.",
  "short_name": "Cortex",
  "description": "Share files, collaborate with your team, and write and save notes — all under one real, authenticated account.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#07080B",
  "theme_color": "#0E9E68",
  "icons": [
    { "src": "/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/favicon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf", "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.oasis.opendocument.text", "text/plain", "text/markdown", "text/csv", "application/rtf",
            ".pdf", ".doc", ".docx", ".odt", ".txt", ".md", ".csv", ".rtf"
          ]
        }
      ]
    }
  }
}
